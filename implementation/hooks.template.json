{
  "description": "Global synchronous local code quality gates",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/code-guard/hook.py\"",
            "timeout": 120,
            "statusMessage": "Initialize local code quality baseline"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/code-guard/hook.py\"",
            "timeout": 120,
            "statusMessage": "Ensure pre-edit code baseline"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/code-guard/hook.py\"",
            "timeout": 120,
            "statusMessage": "Check local code changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/code-guard/hook.py\"",
            "timeout": 180,
            "statusMessage": "Enforce final local code quality gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/code-guard/hook.py\"",
            "timeout": 180,
            "statusMessage": "Enforce subagent local code quality gate"
          }
        ]
      }
    ]
  }
}
